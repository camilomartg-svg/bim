rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // RBAC Helpers
    function getUserData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isAdmin() { 
      let isExplicitAdmin = isSignedIn() && request.auth.token.email.lower() == 'imagina3ddesign@gmail.com';
      let hasAdminDoc = isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData(request.auth.uid).get('role', 'user') == 'admin' ||
          getUserData(request.auth.uid).get('team', '').upper().matches('.*BIM.*') ||
          getUserData(request.auth.uid).get('position', '').upper().matches('.*BIM.*')
        );
      return isExplicitAdmin || hasAdminDoc;
    }

    function isAuthorizedToUpdateIssue(issue) {
      return isAdmin() ||
             issue.creatorId == request.auth.uid ||
             issue.get('assignedEmail', '').lower() == request.auth.token.get('email', '').lower() ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              getUserData(request.auth.uid).get('position', '').upper() == issue.get('assignedPosition', '').upper() &&
              getUserData(request.auth.uid).get('position', '') != '') ||
             (issue.keys().hasAll(['redirectedTo']) && issue.redirectedTo.get('email', '').lower() == request.auth.token.get('email', '').lower()) ||
             (issue.keys().hasAll(['executor']) && issue.executor.get('email', '').lower() == request.auth.token.get('email', '').lower());
    }
    
    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'position'])
        && data.id == request.auth.uid 
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email == request.auth.token.email
        && data.role in ['admin', 'manager', 'technician', 'client']
        && data.position is string && data.position.size() <= 100
        && data.keys().size() >= 5 && data.keys().size() <= 7;
    }

    function isValidAttachment(att) {
      return att.keys().hasAll(['id', 'name', 'url', 'type', 'category'])
        && att.id is string && att.id.size() <= 128
        && att.name is string && att.name.size() <= 1000
        && att.url is string && att.url.size() <= 5000
        && att.type is string 
        && att.category is string
        && att.keys().size() >= 5 && att.keys().size() <= 10;
    }

    function isValidIssue(data) {
      let requiredFields = [
        'code', 'title', 'type', 'degreeOfAction', 'impact', 'description', 
        'status', 'specialty', 'assignedPosition', 'assignedName', 'reviewers', 
        'locations', 'creatorId', 'creatorName', 'createdAt', 'updatedAt', 
        'attachments', 'comments'
      ];
      return data.keys().hasAll(requiredFields)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 2000
        && data.code is string && data.code.size() <= 100
        && data.status is string
        && (data.creatorId == request.auth.uid || isAdmin())
        && data.locations is map 
        && data.attachments is list
        && data.comments is list
        && data.keys().size() >= 18 && data.keys().size() <= 50;
    }

    function isValidReport(data) {
      let requiredFields = ['code', 'title', 'createdAt', 'updatedAt', 'creatorId', 'creatorName', 'status', 'blocks'];
      return data.keys().hasAll(requiredFields)
        && data.title is string && data.title.size() > 0
        && data.creatorId is string
        && data.blocks is list
        && (data.creatorId == request.auth.uid || isAdmin());
    }

    // --- COLLECTION RULES ---

    // USERS
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming()); 
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ISSUES
    match /issues/{issueId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidIssue(incoming());
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Allow any signed-in user to perform auto-sync on issues that originate from a report
        ((existing().get('fromReport', false) == true || issueId.startsWith('issue_e_apr_')) && (
          // Action 5: Auto-Sync / Comprehensive Sync (Full sync from Aprovechamiento report/edit)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'locations', 'attachments', 'dueDate', 'updatedAt', 
            'fromReport', 'reportType', 'sourceReportId'
          ]) ||
          // Action 6: Sync Stockpile / Acopio Details + General properties
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'locations', 'attachments', 'dueDate', 'updatedAt',
            'acopioLargo', 'acopioAncho', 'acopioAlto', 'acopioDuracionProceso',
            'acopioVolumen', 'acopioAreaRecuperada', 'fromReport', 'reportType', 'sourceReportId',
            'status'
          ])
        )) ||
        (isAuthorizedToUpdateIssue(existing()) && (
          // Action 1: Sync Comment Metadata (e.g. Chatbot messages or comments update the lastComment fields)
          incoming().diff(existing()).affectedKeys().hasOnly(['lastComment', 'lastCommentAt', 'updatedAt']) ||
          
          // Action 2: Acopio/Stockpile Metrics (Chatbot or detail page updating metrics)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'acopioLargo', 'acopioAncho', 'acopioAlto', 'acopioDuracionProceso', 
            'acopioVolumen', 'acopioAreaRecuperada', 'materialSNR', 'densidadSNR', 'updatedAt'
          ]) ||

          // Action 3: Acopio Metrics + Comment Metadata (Combined when chatbot records stockpile and records a lastComment)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'acopioLargo', 'acopioAncho', 'acopioAlto', 'acopioDuracionProceso', 
            'acopioVolumen', 'acopioAreaRecuperada', 'materialSNR', 'densidadSNR',
            'lastComment', 'lastCommentAt', 'updatedAt'
          ]) ||

          // Action 4: State Transitions & Assignments (Core issue workflow)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'redirectedTo', 'executor', 'status', 'updatedAt', 'proposedActionPlan', 
            'degreeOfAction', 'impact', 'reviewerEmails', 'reviewers', 'assignedName', 
            'assignedPosition', 'assignedEmail', 'agreementDate', 'rejectionReason', 
            'assignedTeam', 'collaboratorApproved', 'collaboratorApprovedAt', 
            'principalApproved', 'principalApprovedAt'
          ]) ||

          // Action 5: Auto-Sync / Comprehensive Sync (Full sync from Aprovechamiento report/edit)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'locations', 'attachments', 'dueDate', 'updatedAt', 
            'fromReport', 'reportType', 'sourceReportId'
          ]) ||

          // Action 6: Sync Stockpile / Acopio Details + General properties
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'locations', 'attachments', 'dueDate', 'updatedAt',
            'acopioLargo', 'acopioAncho', 'acopioAlto', 'acopioDuracionProceso',
            'acopioVolumen', 'acopioAreaRecuperada', 'fromReport', 'reportType', 'sourceReportId',
            'status'
          ]) ||

          // Action 7: Author edits general fields
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'attachments', 'dueDate', 'locations', 'updatedAt',
            'specialty', 'degreeOfAction', 'impact', 'assignedPosition', 'assignedName',
            'assignedEmail', 'assignedTeam', 'reviewers', 'reviewerEmails', 'status'
          ])
        )) ||
        // Transition: RESPONDIDA (Handled by isAuthorizedToUpdateIssue usually, but kept specific if needed)
        (incoming().status == 'RESPONDIDA' && isAuthorizedToUpdateIssue(existing())) ||
        // Transition: RESUELTA, RECHAZADA, ACUERDO, ANULADA (Only Author)
        (incoming().status in ['RESUELTA', 'RECHAZADA', 'ACUERDO', 'ANULADA'] && existing().creatorId == request.auth.uid)
      );
      
      allow delete: if isSignedIn() && (request.auth.token.email.lower() == 'imagina3ddesign@gmail.com' || isAdmin());

      // COMMENTS SUB-COLLECTION
      match /comments/{commentId} {
        allow list: if isSignedIn();
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      }
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // TEAM
    match /team/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // UNITS
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // CONFIG
    match /config/project {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // REPORTS
    match /reports/{reportId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidReport(incoming());
      allow update: if isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (request.auth.token.email.lower() == 'imagina3ddesign@gmail.com' || isAdmin());
    }

    // TEST CONNECTION
    match /test/connection {
      allow read: if true;
    }
  }
}
